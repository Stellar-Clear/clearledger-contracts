# Stellar network for deployment
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
HORIZON_URL=https://horizon-testnet.stellar.org

# Deployer key alias (created with: stellar keys generate deployer --network testnet --fund)
DEPLOYER_ACCOUNT=deployer
DEPLOY_XLM=false

# USDC on Stellar testnet
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
USDC_ASSET_CODE=USDC

# Native XLM is accessed through its Stellar Asset Contract (SAC).
# Testnet canonical address, derived with:
#   stellar contract id asset --network testnet --asset native
# XLM has no issuer; passing a G... issuer here is incorrect. See docs/NATIVE_XLM.md.
# XLM pool support is EXPERIMENTAL and not yet exposed in the frontend.
XLM_ASSET=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Populated after deploy.sh runs — paste into clearledger-app .env.local
REGISTRY_CONTRACT_ID=
INVOICE_CONTRACT_ID=
ESCROW_USDC_CONTRACT_ID=
# XLM escrow and pool are EXPERIMENTAL and not yet exposed in the frontend.
ESCROW_XLM_CONTRACT_ID=
POOL_USDC_CONTRACT_ID=
POOL_XLM_CONTRACT_ID=

# Agent-registry contract from the separate underwrite-contract repo.
# Populate once it's deployed: deploy.sh/deploy.ps1 then wire it into the
# invoice contract automatically (skipped with a warning when empty) —
# see "Agent Registry Wiring" in DEPLOYMENT.md.
AGENT_REGISTRY_CONTRACT=

